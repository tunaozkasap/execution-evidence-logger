<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.tunaozkasap</groupId>
		<artifactId>execution-evidence-logger-parent</artifactId>
		<version>1.0.0</version>
	</parent>
	<artifactId>execution-evidence-logger-logback</artifactId>
	<name>Execution Evidence Logger Logback</name>
	<description>Logback extension of the Execution Evidence Logger: writes the evidence through logback using LogbackEvidenceLayout.</description>
	<dependencies>
		<dependency>
			<groupId>io.github.tunaozkasap</groupId>
			<artifactId>execution-evidence-logger-core</artifactId>
		</dependency>
		<!-- Provided: applications bring their own logback version -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
